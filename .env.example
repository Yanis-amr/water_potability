# --- IA générative (optionnel) ---
# Laisser vide pour désactiver la couche IA générative (l'app reste fonctionnelle).
#
# Par défaut, ce projet pointe vers l'endpoint Gemini compatible OpenAI
# (gratuit, quotas par minute/jour) plutôt que l'API OpenAI payante.
# Clé gratuite : https://aistudio.google.com/apikey
# Vérifier les quotas à jour : https://ai.google.dev/gemini-api/docs/rate-limits
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# Pour revenir à l'API OpenAI officielle, décommenter :
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
